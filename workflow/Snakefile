
include: "rules/common.smk"
include: "rules/refs.smk"
include: "rules/preprocess.smk"
include: "rules/align.smk"
include: "rules/dedup.smk"
include: "rules/signal.smk"
include: "rules/peaks.smk"
include: "rules/qc.smk"
include: "rules/plots.smk"


rule all:
    input:
        f"{OUTDIR}/qc.tsv",
        [f"{lib_prefix(e, r)}.bam" for e, r in LIBRARIES],
        [
            f"{lib_prefix(e, s)}.{strand}.bw"
            for e in EXPERIMENTS
            for s in samples_of(e)
            for strand in "+-"
        ],
        [
            f"{OUTDIR}/{e}/{e}.{kind}"
            for e in CHIPS
            for kind in ("conservative.narrowPeak.gz", "optimal.narrowPeak.gz")
        ],
        [f"{OUTDIR}/{e}/idr/{e}.{p}.idr.{x}" for e in CHIPS for p in idr_pairs(e) for x in ("txt.gz", "svg")],
        f"{OUTDIR}/qc_funnel.svg",
        [f"{OUTDIR}/{e}/{e}.{plot}.svg" for e in CHIPS for plot in ("fingerprint", "footprint")],
        [f"{OUTDIR}/{e}/{e}.duplicates.svg" for e in EXPERIMENTS],
        [f"{OUTDIR}/{e}/{e}.insert_size.svg" for e in EXPERIMENTS if pe_reps(e)],
